package com.tuusuario.reaperblade;

import org.bukkit.plugin.java.JavaPlugin;

public class ReaperBlade extends JavaPlugin {

    private static ReaperBlade instancia;

    @Override
    public void onEnable() {
        instancia = this;
        getServer().getPluginManager().registerEvents(new ReaperListener(), this);
        getCommand("reaper").setExecutor(new ReaperCommand());
        getLogger().info("¡ReaperBlade activado!");
    }

    public static ReaperBlade getInstancia() {
        return instancia;
    }
}
package com.tuusuario.reaperblade;

import org.bukkit.ChatColor;
import org.bukkit.Material;
import org.bukkit.command.Command;
import org.bukkit.command.CommandExecutor;
import org.bukkit.command.CommandSender;
import org.bukkit.entity.Player;
import org.bukkit.inventory.ItemStack;
import org.bukkit.inventory.meta.ItemMeta;

import java.util.Collections;

public class ReaperCommand implements CommandExecutor {
    @Override
    public boolean onCommand(CommandSender sender, Command command, String label, String[] args) {
        if (!(sender instanceof Player)) return false;

        Player player = (Player) sender;

        ItemStack reaper = new ItemStack(Material.NETHERITE_SWORD);
        ItemMeta meta = reaper.getItemMeta();
        meta.setDisplayName(ChatColor.DARK_PURPLE + "Reaper");
        meta.setLore(Collections.singletonList(ChatColor.GRAY + "Una espada sedienta de almas"));
        reaper.setItemMeta(meta);

        player.getInventory().addItem(reaper);
        player.sendMessage(ChatColor.LIGHT_PURPLE + "¡Has recibido la espada Reaper!");

        return true;
    }
}
package com.tuusuario.reaperblade;

import org.bukkit.*;
import org.bukkit.entity.*;
import org.bukkit.event.EventHandler;
import org.bukkit.event.Listener;
import org.bukkit.event.player.PlayerInteractEvent;
import org.bukkit.inventory.ItemStack;
import org.bukkit.inventory.meta.ItemMeta;
import org.bukkit.scheduler.BukkitRunnable;
import org.bukkit.util.Vector;

import java.util.HashMap;
import java.util.Map;
import java.util.UUID;

public class ReaperListener implements Listener {

    private final Map<Player, Integer> rafagasImpactadas = new HashMap<>();
    private final Map<UUID, Long> cooldowns = new HashMap<>();
    private final int cooldownSeconds = 10; // 10 segundos de enfriamiento

    @EventHandler
    public void onRightClick(PlayerInteractEvent event) {
        Player player = event.getPlayer();

        if (!player.getInventory().getItemInMainHand().hasItemMeta()) return;
        ItemMeta meta = player.getInventory().getItemInMainHand().getItemMeta();
        if (!meta.hasDisplayName()) return;
        if (!meta.getDisplayName().equals(ChatColor.DARK_PURPLE + "Reaper")) return;

        if (cooldowns.containsKey(player.getUniqueId())) {
            long lastUse = cooldowns.get(player.getUniqueId());
            if ((System.currentTimeMillis() - lastUse) < cooldownSeconds * 1000) {
                player.sendMessage(ChatColor.RED + "¡Debes esperar antes de usar la Reaper otra vez!");
                return;
            }
        }

        cooldowns.put(player.getUniqueId(), System.currentTimeMillis());

        // Activar ráfagas con partículas y sonido
        player.sendMessage(ChatColor.RED + "¡Lanzas cortes letales!");
        player.getWorld().playSound(player.getLocation(), Sound.ENTITY_WITHER_SHOOT, 1f, 1.2f);

        for (int i = 0; i < 3; i++) {
            int delay = i * 10;
            new BukkitRunnable() {
                @Override
                public void run() {
                    lanzarRafaga(player);
                }
            }.runTaskLater(ReaperBlade.getInstancia(), delay);
        }
    }

    private void lanzarRafaga(Player player) {
        World world = player.getWorld();
        Location loc = player.getEyeLocation();
        Vector dir = loc.getDirection().normalize();

        ArmorStand proyectil = world.spawn(loc.add(dir.clone().multiply(1)), ArmorStand.class);
        proyectil.setInvisible(true);
        proyectil.setMarker(true);
        proyectil.setGravity(false);
        proyectil.setCustomNameVisible(false);
        proyectil.setSmall(true);

        new BukkitRunnable() {
            int ticks = 0;
            @Override
            public void run() {
                if (ticks++ > 20 || proyectil.isDead()) {
                    proyectil.remove();
                    cancel();
                    return;
                }
                proyectil.teleport(proyectil.getLocation().add(dir.clone().multiply(1)));

                // Partículas de corte
                world.spawnParticle(Particle.SWEEP_ATTACK, proyectil.getLocation(), 2, 0, 0, 0, 0.1);

                // Dentro de la detección de impacto en la rafaga
                  for (Entity nearby : proyectil.getNearbyEntities(1.5, 1.5, 1.5)) {
                if (nearby instanceof Player && nearby != player) {
                Player hit = (Player) nearby;

                rafagasImpactadas.put(hit, rafagasImpactadas.getOrDefault(hit, 0) + 1);

                // Efecto de partículas oscuras al impactar
                hit.getWorld().spawnParticle(Particle.SMOKE_LARGE, hit.getLocation().add(0, 1, 0), 30, 0.5, 0.5, 0.5, 0.01);
                hit.getWorld().spawnParticle(Particle.SOUL_FIRE_FLAME, hit.getLocation().add(0, 1, 0), 20, 0.5, 0.5, 0.5, 0.02);

                // Sonido de golpe crítico
                hit.getWorld().playSound(hit.getLocation(), Sound.ENTITY_PLAYER_ATTACK_CRIT, 1f, 1f);

                proyectil.remove();
                Bukkit.getScheduler().runTaskLater(ReaperBlade.getInstancia(), () -> aplicarDanio(hit), 20L);
                cancel();
                break;
    }
}

            }
        }.runTaskTimer(ReaperBlade.getInstancia(), 0L, 2L);
    }

    private void aplicarDanio(Player jugador) {
        int impactos = rafagasImpactadas.getOrDefault(jugador, 0);

        if (impactos == 1) {
            jugador.damage(6); // 3 corazones
        } else if (impactos == 2) {
            jugador.damage(10); // 5 corazones
        } else if (impactos >= 3) {
            jugador.damage(14); // 7 corazones
        }

        rafagasImpactadas.remove(jugador);
    }
}
